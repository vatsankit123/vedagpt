# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
!.env.example
*.secret

# ── Testing / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.xml

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Sentence-transformers model cache ────────────────────────────────────────
# These directories are created automatically and should not be committed.
backend/.cache/
*.safetensors

# ── Qdrant local storage (if running Qdrant without Docker) ───────────────────
qdrant_storage/

# ── Phase 2: Generated reports (large timestamped reports should not be committed) ──
reports/corpus_validation_*.json
reports/corpus_validation_*.md
reports/retrieval_evaluation_*.json
reports/retrieval_evaluation_*.md
reports/ingestion_*.json
reports/ingestion_*.md

# ── Phase 2: Verified corpus files (contain licensed content - manage separately) ──
backend/data/*.verified.json
backend/data/*.normalized.json
backend/data/*.raw.json

# Keep templates and samples
!backend/data/*.template.json
!backend/data/*.sample.json
