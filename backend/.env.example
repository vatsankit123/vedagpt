# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=VedaGPT API
APP_ENV=development
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Do NOT use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Required for the /api/v1/chat endpoint to generate answers.
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Gemini model identifier available in your Google AI Studio account.
# Confirm the exact model name before setting — do not assume "latest" aliases.
# Examples: gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# ── Embedding ──────────────────────────────────────────────────────────────────
# Supported providers: sentence_transformers | openai | cohere
EMBEDDING_PROVIDER=sentence_transformers
# Model name interpreted by the selected provider.
# sentence_transformers default (compact multilingual, dim=384):
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Vector dimension MUST match the model's actual output dimension.
# paraphrase-multilingual-MiniLM-L12-v2 → 384
# BAAI/bge-m3                            → 1024
# text-embedding-3-small (OpenAI)        → 1536
EMBEDDING_DIMENSION=384

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Leave blank for local unauthenticated Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION=vedagpt_scriptures

# ── Retrieval ──────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
# Relevance threshold in [0.0, 1.0].
# Results below this score are treated as insufficient evidence.
# WARNING: This default requires evaluation and tuning against a real corpus.
# It is NOT a factual confidence score — it is a cosine similarity threshold.
RETRIEVAL_SCORE_THRESHOLD=0.30

# ── Data safety ────────────────────────────────────────────────────────────────
# Set to true ONLY in development to allow DEMO_DATA_NOT_FOR_PRODUCTION records.
# Must be false in any environment with real users.
ALLOW_UNVERIFIED_DEMO_DATA=false
MAX_QUESTION_LENGTH=1000

# ─── Phase 2 Configuration ───────────────────────────────────────────────────

# Generation guard (set to false to disable Gemini calls entirely)
GENERATION_ENABLED=true

# Corpus environment context
CORPUS_ENVIRONMENT=development
# Set to your verified source ID after manifest is reviewed.
CORPUS_SOURCE_ID=
CORPUS_PROFILE_PATH=
CORPUS_SCHEMA_VERSION=2
NORMALIZATION_VERSION=1
PIPELINE_VERSION=phase2-v1

# Embedding (must match your Qdrant collection's embedding model)
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Qdrant versioned collection (change version if you change embedding model)
QDRANT_COLLECTION=vedagpt_bhagavad_gita_v1
QDRANT_DISTANCE=cosine
QDRANT_INGEST_BATCH_SIZE=64

# Document construction strategy: translation | transliteration_and_translation |
# translation_and_commentary | context_window
DOCUMENT_STRATEGY=translation
CONTEXT_WINDOW_SIZE=1

# Retrieval mode: dense (only mode implemented in Phase 2)
RETRIEVAL_MODE=dense
# RETRIEVAL_TOP_K and RETRIEVAL_SCORE_THRESHOLD are already set above.
RETRIEVAL_CANDIDATE_K=20

# Evaluation
EVALUATION_TOP_K_VALUES=1,3,5,10
EVALUATION_OUTPUT_DIR=reports
